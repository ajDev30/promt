## 3. Evaluator State Model & Evidence Levels

The evaluator output will be refactored into an explicit, structured object:

```javascript
{
    targetWord: "glade",
    evidence: "TRANSCRIPT_ONLY" | "ACOUSTIC_VERIFIED" | "INTERMEDIATE_DELTA",

    lexical: {
        matched: true,
        confidence: 0.98
    },

    phonemes: {
        target: ["g", "l", "eɪ", "d"],
        detected: ["g", "l", "eɪ", "d"] | null,
        matched: true | false | null
    },

    syllables: {
        targetCount: 1,
        detectedCount: 1 | 2 | null,
        matched: true | false | null
    },

    blending: {
        verified: true | false,
        score: 0.0 to 1.0 | null,
        internalPauseDetected: true | false | null
    },

    status: "CORRECT_FLUENT"
          | "LEXICAL_MATCH_ONLY"
          | "CORRECT_NEEDS_SMOOTHING"
          | "PHONEME_SUBSTITUTION"
          | "PHONEME_DELETION"
          | "PHONEME_ADDITION"
          | "SYLLABLE_SEGMENTATION_ERROR"
          | "UNRECOGNIZED",
 mastery: boolean, // TRUE only when lexical.matched && (blending.verified || evidence is verified)
    feedbackPrompt: string
}
```

