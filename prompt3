def load_phoneme_model_if_needed():
    global processor, phoneme_model
    if processor is not None and phoneme_model is not None:
        return
    logger.info(f"Loading Wav2Vec2 phoneme model: {PHONEME_MODEL_NAME}...")
    num_threads = min(4, os.cpu_count() or 4)
    torch.set_num_threads(num_threads)
    processor = AutoProcessor.from_pretrained(PHONEME_MODEL_NAME)
    raw_model = AutoModelForCTC.from_pretrained(PHONEME_MODEL_NAME)
    raw_model.eval()
    if DEVICE == "cpu":
        phoneme_model = torch.quantization.quantize_dynamic(
            raw_model, {torch.nn.Linear}, dtype=torch.qint8
        )
    else:
        phoneme_model = raw_model.to(DEVICE)


def run_model_inference(audio: np.ndarray, is_final: bool = False) -> Dict[str, Any]:
    """
    Stateless pure function for Wav2Vec2 phoneme CTC decoding.
    Reads shared immutable model weights with torch.inference_mode.
    Does NOT modify or retain any global student state.
    """
    global processor, phoneme_model
    if processor is None or phoneme_model is None:
        load_phoneme_model_if_needed()

    if processor is None or phoneme_model is None or len(audio) < (SAMPLE_RATE * 0.1):
        return {"phonemes": [], "raw": "", "sequence_confidence": 0.0, "emission_timestamps": []}

    max_amp = float(np.max(np.abs(audio)))
    if max_amp > 1e-4:
        audio = audio / max_amp * 0.90

    inputs = processor(
        audio,
        sampling_rate=SAMPLE_RATE,
        return_tensors="pt",
    )

    with torch.inference_mode():
        outputs = phoneme_model(input_values=inputs.input_values.to(DEVICE))

    logits = outputs.logits[0]  # (T, vocab_size)
    probs = torch.softmax(logits, dim=-1)
    max_probs, argmax_ids = torch.max(probs, dim=-1)

    pad_id = getattr(processor.tokenizer, "pad_token_id", 0)
    blank_id = getattr(phoneme_model.config, "pad_token_id", pad_id)
    ctc_stride_sec = calculate_ctc_temporal_stride(phoneme_model, SAMPLE_RATE)
    decoded = processor.batch_decode(argmax_ids.unsqueeze(0))[0].strip()

    emission_timestamps = []
    emission_probs = []
    prev_id = None

    for t in range(len(argmax_ids)):
        token_id = int(argmax_ids[t])
        if token_id != pad_id and token_id != blank_id and token_id != prev_id:
            token_sym = processor.tokenizer.convert_ids_to_tokens(token_id)
            norm_sym = normalize_phoneme_symbol(token_sym)
            if norm_sym and norm_sym not in {"|", "▁", "<unk>", "#", "_", "."}:
                p_val = float(max_probs[t])
                emission_timestamps.append({
                    "phoneme": norm_sym,
                    "timestamp_sec": round(t * ctc_stride_sec, 3),
                    "prob": round(p_val, 3),
                })
                emission_probs.append(p_val)
        prev_id = token_id

    detected_phonemes = [e["phoneme"] for e in emission_timestamps]
    seq_conf = round(float(np.mean(emission_probs)), 3) if emission_probs else 0.0

    return {
        "phonemes": detected_phonemes,
        "raw": decoded,
        "sequence_confidence": seq_conf,
        "emission_timestamps": emission_timestamps,
    }


