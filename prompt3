# ============================================================
# BOUNDED CPU INFERENCE ENGINE
# ============================================================

@dataclass(order=True)
class InferenceJob:
    priority: int  # 0: High (FINAL decode), 1: Low (PARTIAL decode)
    created_at: float = field(compare=True)
    session_id: str = field(compare=False)
    attempt_id: int = field(compare=False)
    generation: int = field(compare=False)
    audio_data: np.ndarray = field(compare=False)
    is_final: bool = field(compare=False)
    future: asyncio.Future = field(compare=False)


class InferenceEngine:
    """
    Manages bounded CPU inference workers and prioritized task scheduling.
    Guarantees that:
    - High priority FINAL decodes are prioritized over partial sliding window decodes.
    - Concurrency never exceeds MAX_CONCURRENT_INFERENCES.
    - Queue depth never exceeds MAX_INFERENCE_QUEUE.
    - Backpressure rejects or drops optional partial decodes gracefully.
    - Stale jobs from superseded generations are discarded without running inference.
    """

    def __init__(self, max_concurrency: int = MAX_CONCURRENT_INFERENCES, max_queue: int = MAX_INFERENCE_QUEUE):
        self.max_concurrency = max_concurrency
        self.max_queue = max_queue
        self.queue: asyncio.PriorityQueue[InferenceJob] = asyncio.PriorityQueue()
        self.workers: List[asyncio.Task] = []
        self.running: bool = False

        # Observability metrics
        self.active_inferences: int = 0
        self.total_completed: int = 0
        self.total_partial_decodes: int = 0
        self.total_final_decodes: int = 0
        self.total_rejected: int = 0
        self.total_stale_discarded: int = 0
        self.total_inference_time_ms: float = 0.0

    async def start(self):
        if self.running:
            return
        self.running = True
        for i in range(self.max_concurrency):
            worker_task = asyncio.create_task(self._worker_loop(i), name=f"inference-worker-{i}")
            self.workers.append(worker_task)
        logger.info(f"Bounded Inference Engine started with {self.max_concurrency} CPU workers (max_queue={self.max_queue}).")

    async def stop(self):
        self.running = False
        for worker in self.workers:
            worker.cancel()
        self.workers.clear()

    async def _worker_loop(self, worker_id: int):
        while self.running:
            try:
                job = await self.queue.get()
            except asyncio.CancelledError:
                break

            try:
                # Validate job before running CPU inference
                # Check if session is still alive and generation is still current
                is_stale = False
                async with registry_lock:
                    session = session_registry.get(job.session_id)
                    if session is None or session.generation != job.generation or session.attempt_id != job.attempt_id:
                        is_stale = True

                if is_stale:
                    self.total_stale_discarded += 1
                    if not job.future.done():
                        job.future.set_result(None)
                    self.queue.task_done()
                    continue

                self.active_inferences += 1
                start_t = time.perf_counter()

                # Execute pure model forward pass in thread pool
                result = await asyncio.to_thread(run_model_inference, job.audio_data, job.is_final)
                elapsed_ms = (time.perf_counter() - start_t) * 1000.0

                self.total_completed += 1
                self.total_inference_time_ms += elapsed_ms
                if job.is_final:
                    self.total_final_decodes += 1
                else:
                    self.total_partial_decodes += 1

                if not job.future.done():
                    job.future.set_result(result)

            except Exception as exc:
                logger.error(f"Inference worker {worker_id} error: {exc}", exc_info=True)
                if not job.future.done():
                    job.future.set_exception(exc)
            finally:
                self.active_inferences = max(0, self.active_inferences - 1)
                self.queue.task_done()

    async def submit_inference(
        self,
        session_id: str,
        attempt_id: int,
        generation: int,
        audio_data: np.ndarray,
        is_final: bool,
    ) -> Optional[Dict[str, Any]]:
        """
        Submits an audio chunk for phoneme decoding.
        Returns decoded phoneme result or None if dropped due to queue pressure/staleness.
        """
        if not self.running or len(self.workers) == 0:
            await self.start()

        priority = 0 if is_final else 1
        current_qsize = self.queue.qsize()

        if current_qsize >= self.max_queue:
            if not is_final:
                # Drop lower-priority partial decodes under load without failing attempt
                self.total_rejected += 1
                logger.debug(f"session={session_id} attempt={attempt_id} gen={generation} event=partial_decode_dropped queue_size={current_qsize}")
                return None
            else:
                # For final assessments under extreme saturation, log warning
                logger.warning(f"session={session_id} attempt={attempt_id} gen={generation} event=high_queue_final_inference queue_size={current_qsize}")

        loop = asyncio.get_running_loop()
        future: asyncio.Future = loop.create_future()

        job = InferenceJob(
            priority=priority,
            created_at=time.time(),
            session_id=session_id,
            attempt_id=attempt_id,
            generation=generation,
            audio_data=audio_data.copy(),
            is_final=is_final,
            future=future,
        )

        await self.queue.put(job)
        return await future

    def get_metrics(self) -> Dict[str, Any]:
        avg_time = (self.total_inference_time_ms / self.total_completed) if self.total_completed > 0 else 0.0
        return {
            "active_inferences": self.active_inferences,
            "queue_size": self.queue.qsize(),
            "total_completed": self.total_completed,
            "total_partial_decodes": self.total_partial_decodes,
            "total_final_decodes": self.total_final_decodes,
            "total_rejected": self.total_rejected,
            "total_stale_discarded": self.total_stale_discarded,
            "average_inference_time_ms": round(avg_time, 2),
        }


