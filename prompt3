class PronunciationProfile:
    """
    General phoneme compatibility system with explicit match types and penalties.
    Operates strictly at the phoneme level without word-specific hacks.
    """
    VOWEL_EQUIVALENCES = {
        "æ": {"æ": 0.0, "a": 0.05, "ɐ": 0.05},
        "ʌ": {"ʌ": 0.0, "a": 0.05, "ɐ": 0.05, "ə": 0.05},
        "ɑː": {"ɑː": 0.0, "a": 0.05, "oʊ": 0.10, "ɔː": 0.05},
        "iː": {"iː": 0.0, "i": 0.05, "ɪ": 0.05},
        "uː": {"uː": 0.0, "u": 0.05, "ʊ": 0.05},
        "ə": {"ə": 0.0, "ʌ": 0.05, "a": 0.05},
    }

    RHOTIC_EQUIVALENCES = {
        "ɹ": {"ɹ": 0.0, "r": 0.05, "ɾ": 0.05, "ɚ": 0.05},
        "r": {"r": 0.0, "ɹ": 0.05, "ɾ": 0.05, "ɚ": 0.05},
        "ɚ": {"ɚ": 0.0, "ɹ": 0.05, "r": 0.05, "ə": 0.05},
    }

    DEVELOPMENTAL_EQUIVALENCES = {
        "f": {"f": 0.0, "p": 0.10},
        "v": {"v": 0.0, "b": 0.10},
        "θ": {"θ": 0.0, "t": 0.10, "s": 0.10},
        "ð": {"ð": 0.0, "d": 0.10, "z": 0.10},
        "ʃ": {"ʃ": 0.0, "s": 0.10},
        "tʃ": {"tʃ": 0.0, "ts": 0.10},
        "dʒ": {"dʒ": 0.0, "dz": 0.10},
    }

    ASPIRATION_EQUIVALENCES = {
        "p": {"p": 0.0, "pʰ": 0.0},
        "pʰ": {"pʰ": 0.0, "p": 0.0},
        "t": {"t": 0.0, "tʰ": 0.0},
        "tʰ": {"tʰ": 0.0, "t": 0.0},
        "k": {"k": 0.0, "kʰ": 0.0},
        "kʰ": {"kʰ": 0.0, "k": 0.0},
    }

    @classmethod
    def check_compatibility(cls, target: str, detected: str) -> Tuple[bool, str, float]:
        target = normalize_phoneme_symbol(target)
        detected = normalize_phoneme_symbol(detected)

        if target == detected:
            return True, "EXACT", 0.0

        if target in cls.ASPIRATION_EQUIVALENCES and detected in cls.ASPIRATION_EQUIVALENCES[target]:
            return True, "ASPIRATION_VARIATION", cls.ASPIRATION_EQUIVALENCES[target][detected]

        if target in cls.VOWEL_EQUIVALENCES and detected in cls.VOWEL_EQUIVALENCES[target]:
            return True, "REGIONAL_VOWEL_VARIATION", cls.VOWEL_EQUIVALENCES[target][detected]

        if target in cls.RHOTIC_EQUIVALENCES and detected in cls.RHOTIC_EQUIVALENCES[target]:
            return True, "RHOTIC_VARIATION", cls.RHOTIC_EQUIVALENCES[target][detected]

        if target in cls.DEVELOPMENTAL_EQUIVALENCES and detected in cls.DEVELOPMENTAL_EQUIVALENCES[target]:
            return True, "DEVELOPMENTAL_TOLERANCE", cls.DEVELOPMENTAL_EQUIVALENCES[target][detected]

        return False, "MISMATCH", 1.0


# ============================================================
# PHONEME & SYLLABLE NORMALIZATION
# ============================================================

def normalize_phoneme_symbol(symbol: str) -> str:
    """
    Normalizes a single phoneme symbol, stripping stress and special tokens
    without destroying boundary delimiters before parsing.
    """
    if symbol is None:
        return ""
    symbol = str(symbol).strip()
    if not symbol:
        return ""
    for ch in ["ˈ", "ˌ", "▁", "<unk>", "#"]:
        symbol = symbol.replace(ch, "")
    if symbol in {"pʰ", "tʰ", "kʰ"}:
        symbol = symbol[0]
    return symbol


def normalize_phonemes(phonemes: List[str]) -> List[str]:
    result = []
    for p in phonemes:
        norm = normalize_phoneme_symbol(p)
        if norm and norm not in {"|", "_", "."}:
            result.append(norm)
    return result


def is_vowel_phoneme(phone: str) -> bool:
    """
    Explicit normalized phoneme matching for vowel nuclei.
    Prevents substring searches from splitting diphthongs into multiple vowels.
    """
    phone = normalize_phoneme_symbol(phone)
    return phone in {
        "æ", "ʌ", "ɑː", "iː", "uː", "ə",
        "a", "e", "i", "o", "u",
        "ɪ", "ʊ", "ɛ", "ɔː", "ɒ",
        "eɪ", "aɪ", "ɔɪ", "aʊ", "oʊ",
        "ɚ", "ɝ", "ɐ",
    }


def dynamic_syllabify_word(word: str) -> Tuple[int, List[List[str]], List[str]]:
    """
    Dynamically extracts syllables and phonemes using eSpeak phonemization
    and explicit vowel-nucleus partitioning.
    """
    clean_w = re.sub(r"[^a-zA-Z']", "", word.lower())
    if not clean_w:
        return 1, [[]], []

    sep = Separator(phone="_", syllable=".", word=" | ")
    try:
        raw = phonemize(
            clean_w,
            language="en-us",
            backend="espeak",
            strip=True,
            preserve_punctuation=False,
            with_stress=False,
            separator=sep,
        )
    except Exception as e:
        logger.warning(f"eSpeak phonemize failed for '{word}': {e}")
        raw = clean_w

    raw_clean = raw.replace("|", "_").strip()
    raw_tokens = [normalize_phoneme_symbol(p) for p in raw_clean.split("_") if p.strip()]
    flat_phonemes = [p for p in raw_tokens if p and p not in {"|", "_", "."}]

    if not flat_phonemes:
        return 1, [[clean_w]], [clean_w]

    # Find vowel nuclei using explicit phoneme set
    vowel_indices = [i for i, p in enumerate(flat_phonemes) if is_vowel_phoneme(p)]

    if not vowel_indices:
        return 1, [flat_phonemes], flat_phonemes

    syllables = []
    num_vowels = len(vowel_indices)

    for v_idx in range(num_vowels):
        curr_v = vowel_indices[v_idx]
        prev_v = vowel_indices[v_idx - 1] if v_idx > 0 else None
        next_v = vowel_indices[v_idx + 1] if v_idx < num_vowels - 1 else None

        s_start = 0 if prev_v is None else prev_v + 1 + ((curr_v - prev_v - 1) // 2)
        s_end = len(flat_phonemes) if next_v is None else curr_v + 1 + ((next_v - curr_v - 1) // 2)

        syllables.append(flat_phonemes[s_start:s_end])

    syllable_count = max(1, len(syllables))
    return syllable_count, syllables, flat_phonemes


def get_target_info(text: str) -> Dict[str, Any]:
    """
    Decomposes target text / passage into structured target words, dynamic syllables,
    and global phoneme spans.
    """
    text = text.strip()
    if not text:
        raise ValueError("Target text cannot be empty.")

    words = re.findall(r"[a-zA-Z']+", text)
    if not words:
        words = [text]

    word_details = []
    all_phonemes = []
    phoneme_cursor = 0

    for idx, w in enumerate(words):
        s_count, syllables, phones = dynamic_syllabify_word(w)
        span_start = phoneme_cursor
        span_end = phoneme_cursor + len(phones)

        word_details.append({
            "index": idx,
            "word": w,
            "syllables": syllables,
            "syllable_count": s_count,
            "phonemes": phones,
            "phoneme_count": len(phones),
            "start_phoneme_idx": span_start,
            "end_phoneme_idx": span_end,
            "syllable_evidence": "ESTIMATED",
        })

        all_phonemes.extend(phones)
        phoneme_cursor = span_end

    return {
        "text": text,
        "is_sentence": len(words) > 1,
        "word_count": len(words),
        "words": word_details,
        "phonemes": all_phonemes,
        "total_phonemes": len(all_phonemes),
    }


# ============================================================
# LAYER 2: TWO-SIDED LEVENSHTEIN DP PHONEME ALIGNMENT
# ============================================================

def align_phonemes_detailed(target: List[str], detected: List[str]) -> Dict[str, Any]:
    """
    Computes global Levenshtein DP sequence alignment between target and detected phonemes.
    Stores BOTH target_idx and detected_idx in every alignment operation.
    """
    target = normalize_phonemes(target)
    detected = normalize_phonemes(detected)

    n, m = len(target), len(detected)
    dp = [[0.0] * (m + 1) for _ in range(n + 1)]
    operation = [[None] * (m + 1) for _ in range(n + 1)]
    match_info = [[None] * (m + 1) for _ in range(n + 1)]

    for i in range(n + 1):
        dp[i][0] = float(i)
    for j in range(m + 1):
        dp[0][j] = float(j)

    for i in range(1, n + 1):
        for j in range(1, m + 1):
            compatible, match_type, penalty = PronunciationProfile.check_compatibility(target[i - 1], detected[j - 1])
            cost = penalty if compatible else 1.0

            choices = [
                (dp[i - 1][j - 1] + cost, "MATCH" if compatible else "SUBSTITUTION", match_type, penalty),
                (dp[i - 1][j] + 1.0, "DELETION", "OMISSION", 1.0),
                (dp[i][j - 1] + 1.0, "INSERTION", "EXTRA", 1.0),
            ]
            best = min(choices, key=lambda x: x[0])
            dp[i][j] = best[0]
            operation[i][j] = best[1]
            match_info[i][j] = (best[2], best[3])

    # Backtrack optimal alignment path
    i, j = n, m
    alignment = []
    exact_matches = 0
    regional_matches = 0
    developmental_matches = 0
    substitutions = []
    deletions = []
    insertions = []
    total_regional_points = 0.0

    while i > 0 or j > 0:
        op = operation[i][j]
        m_type, penalty = match_info[i][j] if match_info[i][j] else ("NONE", 1.0)

        if op in {"MATCH", "SUBSTITUTION"}:
            t_phone = target[i - 1]
            d_phone = detected[j - 1]
            t_idx = i - 1
            d_idx = j - 1

            if op == "MATCH":
                alignment.append({
                    "target_idx": t_idx,
                    "detected_idx": d_idx,
                    "target": t_phone,
                    "detected": d_phone,
                    "operation": "MATCH",
                    "match_type": m_type,
                    "cost": penalty,
                })
                total_regional_points += (1.0 - penalty)
                if m_type == "EXACT":
                    exact_matches += 1
                elif m_type == "DEVELOPMENTAL_TOLERANCE":
                    developmental_matches += 1
                else:
                    regional_matches += 1
            else:
                alignment.append({
                    "target_idx": t_idx,
                    "detected_idx": d_idx,
                    "target": t_phone,
                    "detected": d_phone,
                    "operation": "SUBSTITUTION",
                    "match_type": "MISMATCH",
                    "cost": 1.0,
                })
                substitutions.append({
                    "target_idx": t_idx,
                    "detected_idx": d_idx,
                    "target": t_phone,
                    "detected": d_phone,
                })

            i -= 1
            j -= 1

        elif op == "DELETION":
            t_phone = target[i - 1]
            t_idx = i - 1
            alignment.append({
                "target_idx": t_idx,
                "detected_idx": None,
                "target": t_phone,
                "detected": None,
                "operation": "DELETION",
                "match_type": "OMISSION",
                "cost": 1.0,
            })
            deletions.append({"target_idx": t_idx, "target": t_phone})
            i -= 1

        elif op == "INSERTION":
            d_phone = detected[j - 1]
            d_idx = j - 1
            if i < n and (i == 0 or (d_phone in target[i:min(n, i + 6)] and d_phone not in target[max(0, i - 3):i])):
                t_idx = i
            elif i < n and (target[i] == d_phone or PronunciationProfile.check_compatibility(target[i], d_phone)[0]):
                t_idx = i
            else:
                t_idx = max(0, i - 1)
            alignment.append({
                "target_idx": None,
                "detected_idx": d_idx,
                "target": None,
                "detected": d_phone,
                "operation": "INSERTION",
                "match_type": "EXTRA",
                "cost": 1.0,
                "near_target_idx": t_idx,
            })
            insertions.append({"detected_idx": d_idx, "detected": d_phone, "near_target_idx": t_idx})
            j -= 1
        else:
            break

    alignment.reverse()
    total_target = max(len(target), 1)
    strict_score = max(0.0, (exact_matches - 1.0 * len(insertions)) / total_target)
    regional_score = max(0.0, min(1.0, (total_regional_points - 1.0 * len(insertions)) / total_target))
    edit_distance = dp[n][m]

    return {
        "target": target,
        "detected": detected,
        "strict_score": round(strict_score, 3),
        "regional_score": round(regional_score, 3),
        "exact_matches": exact_matches,
        "regional_matches": regional_matches,
        "developmental_matches": developmental_matches,
        "substitutions": substitutions,
        "deletions": deletions,
        "insertions": insertions,
        "edit_distance": round(edit_distance, 3),
        "alignment": alignment,
    }


