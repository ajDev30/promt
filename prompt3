@app.websocket("/ws/stream")
@app.websocket("/ws")
async def websocket_stream_endpoint(websocket: WebSocket):
    await websocket.accept()

    # Generate authoritative connection-scoped session UUID
    session_id = str(uuid.uuid4())
    connection_id = str(uuid.uuid4())
    logger.info(f"session={session_id} connection={connection_id} event=client_connected")

    session: Optional[StreamingSession] = None
    current_generation: int = 0
    attempt_history: List[Dict[str, Any]] = []
    attempt_counts: Dict[str, int] = {}

    # Initialize placeholder session and register in global registry
    session = StreamingSession(
        websocket=websocket,
        session_id=session_id,
        connection_id=connection_id,
        target_text="The quick brown fox jumps over the lazy dog",
        attempt_id=1,
        is_retry=False,
        generation=0,
    )
    async with registry_lock:
        session_registry[session_id] = session

    try:
        while True:
            # Idle timeout guard
            try:
                message = await asyncio.wait_for(websocket.receive(), timeout=WEBSOCKET_IDLE_TIMEOUT_SEC)
            except asyncio.TimeoutError:
                logger.info(f"session={session_id} event=idle_timeout_disconnect")
                await websocket.send_json({"type": "timeout", "message": "Session closed due to inactivity."})
                break

            if message.get("type") == "websocket.disconnect":
                logger.info(f"session={session_id} event=client_disconnect_received")
                break

            # Handle JSON Control Message
            if "text" in message and message["text"]:
                try:
                    data = json.loads(message["text"])
                    msg_type = data.get("type", "")

                    if msg_type in {"start", "init", "start_attempt", "config"}:
                        target_text = data.get("target") or data.get("target_text") or data.get("text") or data.get("word") or "The quick brown fox jumps over the lazy dog"
                        norm_target = target_text.strip().lower()

                        # Invalidate prior attempt and cancel pending decode tasks
                        if session is not None:
                            session.finalized = True
                            await session.cancel_attempt_tasks()

                        current_generation += 1

                        req_attempt_id = data.get("attempt_id")
                        if req_attempt_id is not None and isinstance(req_attempt_id, int):
                            attempt_id = req_attempt_id
                            is_retry = bool(data.get("is_retry", attempt_id > 1))
                        else:
                            prior_count = attempt_counts.get(norm_target, 0)
                            attempt_id = prior_count + 1
                            is_retry = prior_count > 0

                        attempt_counts[norm_target] = max(attempt_counts.get(norm_target, 0), attempt_id)

                        # Create fresh attempt state within the same connection session UUID
                        session = StreamingSession(
                            websocket=websocket,
                            session_id=session_id,
                            connection_id=connection_id,
                            moodle_user_id=data.get("moodle_user_id"),
                            moodle_attempt_id=data.get("moodle_attempt_id"),
                            target_text=target_text,
                            attempt_id=attempt_id,
                            is_retry=is_retry,
                            generation=current_generation,
                        )
                        async with registry_lock:
                            session_registry[session_id] = session

                        ready_type = "attempt_ready" if msg_type == "start_attempt" else "ready"
                        ready_payload = {
                            "type": ready_type,
                            "session_id": session.session_id,
                            "attempt_id": session.attempt_id,
                            "is_retry": session.is_retry,
                            "generation": session.generation,
                            "target": session.target_info,
                            "attempt_history_count": len(attempt_history),
                            "message": f"Session ready for attempt {session.attempt_id} ({'retry' if session.is_retry else 'initial'}) of '{session.target_text}'",
                        }
                        await websocket.send_json(ready_payload)
                        logger.info(f"session={session_id} attempt={session.attempt_id} gen={current_generation} is_retry={session.is_retry} target='{session.target_text}' event=attempt_initialized")

                    elif msg_type == "stop":
                        if session and not session.finalized:
                            session.finalized = True
                            expected_gen = session.generation
                            expected_att = session.attempt_id

                            # Final full-recording decode pass through bounded inference engine (Priority 0)
                            dec_res = await inference_engine.submit_inference(
                                session_id=session.session_id,
                                attempt_id=expected_att,
                                generation=expected_gen,
                                audio_data=session.audio_buffer.copy(),
                                is_final=True,
                            )

                            if dec_res is not None and session.generation == expected_gen and session.attempt_id == expected_att:
                                session.last_detected_phonemes = dec_res["phonemes"]
                                session.last_raw_text = dec_res["raw"]
                                session.last_emission_timestamps = dec_res["emission_timestamps"]
                                session.last_sequence_confidence = dec_res["sequence_confidence"]

                                final_result = session.generate_assessment(is_final=True)
                                scores = final_result.get("scores", {})
                                p_score = scores.get("regional_phoneme_score", scores.get("phoneme_accuracy", 0.0))
                                b_score = scores.get("blending_score", 1.0)
                                attempt_history.append({
                                    "session_id": session.session_id,
                                    "attempt_id": session.attempt_id,
                                    "is_retry": session.is_retry,
                                    "generation": session.generation,
                                    "target": session.target_text,
                                    "status": final_result.get("status"),
                                    "mastery": final_result.get("mastery", False),
                                    "phoneme_accuracy": p_score,
                                    "blending_score": b_score,
                                    "overall_score": scores.get("overall_score", 0.0),
                                    "timestamp": time.time(),
                                })

                                await send_session_json(
                                    session=session,
                                    websocket=websocket,
                                    payload={
                                        "type": "final",
                                        "result": final_result,
                                        "attempt_history": attempt_history,
                                        "auto_stopped": False,
                                    },
                                    expected_session_id=session.session_id,
                                    expected_attempt_id=expected_att,
                                    expected_generation=expected_gen,
                                )
                                logger.info(f"session={session_id} attempt={session.attempt_id} gen={expected_gen} event=final_assessment_sent")

                    elif msg_type in {"reset_history", "clear_history"}:
                        attempt_history.clear()
                        attempt_counts.clear()
                        await websocket.send_json({
                            "type": "history_reset",
                            "session_id": session.session_id if session else session_id,
                            "message": "Attempt history and attempt counters have been reset.",
                        })

                except json.JSONDecodeError:
                    pass

            # Handle Binary PCM Audio Chunk
            elif "bytes" in message and message["bytes"]:
                if session is None or session.finalized or session.generation != current_generation:
                    continue

                session.ingest_pcm(message["bytes"])

                last_active = session.speech_frames[-1] if session.speech_frames else False
                await send_session_json(
                    session=session,
                    websocket=websocket,
                    payload={
                        "type": "vad",
                        "is_speech": last_active,
                        "silence_ms": round(session.current_silence_duration_ms, 1),
                        "speech_duration_ms": round(session.total_speech_duration_ms, 1),
                    },
                    expected_session_id=session.session_id,
                    expected_attempt_id=session.attempt_id,
                    expected_generation=session.generation,
                )

                # Auto-Endpointing (User completed reading followed by sustained silence)
                if session.is_auto_endpoint():
                    session.finalized = True
                    expected_gen = session.generation
                    expected_att = session.attempt_id

                    dec_res = await inference_engine.submit_inference(
                        session_id=session.session_id,
                        attempt_id=expected_att,
                        generation=expected_gen,
                        audio_data=session.audio_buffer.copy(),
                        is_final=True,
                    )

                    if dec_res is not None and session.generation == expected_gen and session.attempt_id == expected_att:
                        session.last_detected_phonemes = dec_res["phonemes"]
                        session.last_raw_text = dec_res["raw"]
                        session.last_emission_timestamps = dec_res["emission_timestamps"]
                        session.last_sequence_confidence = dec_res["sequence_confidence"]

                        final_result = session.generate_assessment(is_final=True)
                        scores = final_result.get("scores", {})
                        p_score = scores.get("regional_phoneme_score", scores.get("phoneme_accuracy", 0.0))
                        b_score = scores.get("blending_score", 1.0)
                        attempt_history.append({
                            "session_id": session.session_id,
                            "attempt_id": session.attempt_id,
                            "is_retry": session.is_retry,
                            "generation": session.generation,
                            "target": session.target_text,
                            "status": final_result.get("status"),
                            "mastery": final_result.get("mastery", False),
                            "phoneme_accuracy": p_score,
                            "blending_score": b_score,
                            "overall_score": scores.get("overall_score", 0.0),
                            "timestamp": time.time(),
                        })

                        await send_session_json(
                            session=session,
                            websocket=websocket,
                            payload={
                                "type": "final",
                                "result": final_result,
                                "attempt_history": attempt_history,
                                "auto_stopped": True,
                            },
                            expected_session_id=session.session_id,
                            expected_attempt_id=expected_att,
                            expected_generation=expected_gen,
                        )
                        logger.info(f"session={session_id} attempt={session.attempt_id} gen={expected_gen} event=auto_endpoint_final_assessment_sent")
                        continue

                # Run non-blocking background sliding-window decoding periodically
                if session.should_decode() and not session.finalized and not session.is_decoding:
                    session.is_decoding = True
                    t = asyncio.create_task(
                        run_background_decode(session, websocket, current_generation, session.attempt_id)
                    )
                    session.background_tasks.add(t)
                    t.add_done_callback(session.background_tasks.discard)

    except WebSocketDisconnect:
        logger.info(f"session={session_id} event=client_disconnected")
    except Exception as exc:
        logger.error(f"session={session_id} event=websocket_error error={exc}", exc_info=True)
    finally:
        if session:
            await session.cleanup()


