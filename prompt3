@app.on_event("startup")
async def startup_event():
    global processor, phoneme_model, espeak_available

    logger.info("=" * 60)
    logger.info("STARTING STREAMING ASR & ACOUSTIC ASSESSMENT SERVICE (v3.4)")
    logger.info(f"Device: {DEVICE}")
    logger.info(f"Sample Rate: {SAMPLE_RATE} Hz")
    logger.info(f"Max Concurrent Inferences: {MAX_CONCURRENT_INFERENCES}")
    logger.info(f"Max Inference Queue: {MAX_INFERENCE_QUEUE}")
    logger.info("=" * 60)

    # Start Bounded Inference Engine
    await inference_engine.start()

    # Check eSpeak
    espeak_exe = shutil.which("espeak-ng") or shutil.which("espeak")
    if espeak_exe:
        logger.info(f"eSpeak found: {espeak_exe}")
        try:
            test_res = phonemize("test", language="en-us", backend="espeak", strip=True)
            espeak_available = bool(test_res)
            logger.info("eSpeak phonemizer ready.")
        except Exception as e:
            logger.warning(f"eSpeak test failed: {e}")
    else:
        logger.warning("eSpeak executable not found.")

    # Load Phoneme Model with CPU Multi-threading & Dynamic INT8 Quantization
    logger.info(f"Loading Wav2Vec2 phoneme model: {PHONEME_MODEL_NAME}...")
    try:
        num_threads = min(4, os.cpu_count() or 4)
        torch.set_num_threads(num_threads)
        logger.info(f"PyTorch configured with {num_threads} CPU threads.")

        processor = AutoProcessor.from_pretrained(PHONEME_MODEL_NAME)
        raw_model = AutoModelForCTC.from_pretrained(PHONEME_MODEL_NAME)
        raw_model.eval()

        if DEVICE == "cpu":
            logger.info("Applying dynamic INT8 quantization for CPU inference...")
            phoneme_model = torch.quantization.quantize_dynamic(
                raw_model, {torch.nn.Linear}, dtype=torch.qint8
            )
            logger.info("INT8 quantization enabled.")
        else:
            phoneme_model = raw_model.to(DEVICE)

        stride_sec = calculate_ctc_temporal_stride(phoneme_model, SAMPLE_RATE)
        pad_id = getattr(processor.tokenizer, "pad_token_id", 0)
        blank_id = getattr(phoneme_model.config, "pad_token_id", pad_id)
        logger.info(f"Wav2Vec2 phoneme model loaded: CTC frame stride={stride_sec*1000:.1f}ms, CTC blank ID={blank_id} ({pad_id})")
    except Exception as exc:
        logger.error(f"Failed to load phoneme model: {exc}")

    logger.info("=" * 60)
    logger.info(f"Streaming server running at http://{APP_HOST}:{APP_PORT}")
    logger.info(f"WebSocket endpoint: ws://{APP_HOST}:{APP_PORT}/ws/stream")
    logger.info("=" * 60)


@app.on_event("shutdown")
async def shutdown_event():
    logger.info("Shutting down Streaming ASR Service...")
    await inference_engine.stop()


