# ============================================================
# DEFENSIVE MESSAGE DISPATCH (4-WAY INVARIANT VALIDATION)
# ============================================================

async def send_session_json(
    session: StreamingSession,
    websocket: Optional[WebSocket],
    payload: Dict[str, Any],
    expected_session_id: str,
    expected_attempt_id: int,
    expected_generation: int,
) -> bool:
    """
    Guarantees message is only sent if:
    1. Session is not finalized.
    2. Session ID matches expected ID.
    3. Generation token matches expected generation.
    4. Attempt ID matches expected attempt ID.
    5. WebSocket connection is active.
    """
    if session.finalized and payload.get("type") != "final":
        return False
    if session.session_id != expected_session_id:
        return False
    if session.generation != expected_generation:
        return False
    if session.attempt_id != expected_attempt_id:
        return False
    if websocket is None:
        return False

    payload["session_id"] = session.session_id
    payload["attempt_id"] = session.attempt_id
    payload["generation"] = session.generation
    payload["is_retry"] = session.is_retry
    payload["event"] = payload.get("type", "update")

    try:
        await websocket.send_json(payload)
        return True
    except Exception as e:
        logger.debug(f"session={session.session_id} event=send_failed error={e}")
        return False


async def run_background_decode(session: StreamingSession, websocket: WebSocket, expected_generation: int, expected_attempt_id: Optional[int] = None):
    """
    Executes an intermediate partial sliding-window decode through the bounded inference engine.
    Silently discards results if superseded by a newer generation or attempt.
    """
    if expected_attempt_id is None:
        expected_attempt_id = session.attempt_id
    try:
        # Extract sliding audio window
        window_samples = int(SAMPLE_RATE * (PHONEME_WINDOW_MS / 1000.0))
        audio_chunk = session.audio_buffer[-window_samples:].copy() if len(session.audio_buffer) > window_samples else session.audio_buffer.copy()

        # Submit to bounded inference engine (priority 1: low)
        dec_res = await inference_engine.submit_inference(
            session_id=session.session_id,
            attempt_id=expected_attempt_id,
            generation=expected_generation,
            audio_data=audio_chunk,
            is_final=False,
        )

        if dec_res is None:
            return  # Dropped due to queue backpressure or superseded generation

        # 4-way defensive check before updating session results
        if session.finalized or session.generation != expected_generation or session.attempt_id != expected_attempt_id:
            return

        session.last_decode_sample = len(session.audio_buffer)
        session.last_detected_phonemes = dec_res["phonemes"]
        session.last_raw_text = dec_res["raw"]
        session.last_emission_timestamps = dec_res["emission_timestamps"]
        session.last_sequence_confidence = dec_res["sequence_confidence"]

        partial_result = session.generate_assessment(is_final=False)

        await send_session_json(
            session=session,
            websocket=websocket,
            payload={"type": "partial", "result": partial_result},
            expected_session_id=session.session_id,
            expected_attempt_id=expected_attempt_id,
            expected_generation=expected_generation,
        )

        words = partial_result.get("words", [])
        completed_count = sum(1 for w in words if w.get("status") in {"CORRECT_FLUENT", "CORRECT_BUT_SEGMENTED", "ACCEPTABLE_REGIONAL"})
        active_idx = min(completed_count, len(words) - 1) if words else 0

        await send_session_json(
            session=session,
            websocket=websocket,
            payload={
                "type": "progress",
                "current_word_index": active_idx,
                "current_word": words[active_idx]["target_word"] if active_idx < len(words) else "",
                "words_completed": completed_count,
                "words_total": len(words),
            },
            expected_session_id=session.session_id,
            expected_attempt_id=expected_attempt_id,
            expected_generation=expected_generation,
        )
    except asyncio.CancelledError:
        pass
    except Exception as e:
        logger.debug(f"session={session.session_id} event=background_decode_error error={e}")
    finally:
        session.is_decoding = False


