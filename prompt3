# LAYER 3: ACOUSTIC VAD & GAP-BASED PAUSE DETECTION
# ============================================================

def detect_speech_regions_from_frames(
    speech_frames: List[bool],
    frame_ms: int = FRAME_MS,
    vad_end_silence_ms: int = VAD_END_SILENCE_MS,
    min_speech_ms: int = MIN_SPEECH_MS,
) -> List[Dict[str, Any]]:
    """
    Implements robust VAD hysteresis. Consecutive speech frames merge through short silence dips.
    Speech region closes only after sustained silence >= vad_end_silence_ms.
    """
    regions = []
    in_speech = False
    start_frame = 0
    last_active_frame = 0
    silence_frame_limit = int(vad_end_silence_ms / frame_ms)

    for idx, active in enumerate(speech_frames):
        if active:
            if not in_speech:
                in_speech = True
                start_frame = idx
            last_active_frame = idx
        else:
            if in_speech:
                silence_gap_frames = idx - last_active_frame
                if silence_gap_frames >= silence_frame_limit:
                    duration_ms = (last_active_frame - start_frame + 1) * frame_ms
                    if duration_ms >= min_speech_ms:
                        regions.append({
                            "start_sec": round(start_frame * frame_ms / 1000.0, 3),
                            "end_sec": round((last_active_frame + 1) * frame_ms / 1000.0, 3),
                            "duration_ms": duration_ms,
                        })
                    in_speech = False

    if in_speech:
        duration_ms = (last_active_frame - start_frame + 1) * frame_ms
        if duration_ms >= min_speech_ms:
            regions.append({
                "start_sec": round(start_frame * frame_ms / 1000.0, 3),
                "end_sec": round((last_active_frame + 1) * frame_ms / 1000.0, 3),
                "duration_ms": duration_ms,
            })

    return regions


def detect_internal_pauses(
    speech_regions: List[Dict[str, Any]],
    min_internal_pause_ms: int = MIN_INTERNAL_PAUSE_MS,
    strong_pause_ms: int = STRONG_PAUSE_MS,
) -> List[Dict[str, Any]]:
    """
    Calculates acoustic gaps strictly BETWEEN consecutive finalized speech regions.
    Leading silence and trailing silence are strictly excluded.
    """
    pauses = []
    if len(speech_regions) < 2:
        return pauses

    for i in range(len(speech_regions) - 1):
        prev_end = speech_regions[i]["end_sec"]
        next_start = speech_regions[i + 1]["start_sec"]
        gap_ms = round((next_start - prev_end) * 1000.0, 1)

        is_internal = gap_ms >= min_internal_pause_ms
        pauses.append({
            "start_sec": prev_end,
            "end_sec": next_start,
            "duration_ms": gap_ms,
            "is_internal_pause": is_internal,
            "strong": gap_ms >= strong_pause_ms,
        })

    return [p for p in pauses if p["is_internal_pause"]]


def calculate_blending_score(
    pauses: List[Dict[str, Any]],
    syllable_count: int = 1,
) -> Dict[str, Any]:
    """
    Calculates acoustic blending score and status from assigned pauses and syllable structure.
    """
    has_internal_pause = len(pauses) > 0
    max_pause_ms = max([p["duration_ms"] for p in pauses], default=0.0)
    has_strong_pause = any(p.get("strong", False) or p["duration_ms"] >= STRONG_PAUSE_MS for p in pauses)

    if syllable_count <= 1:
        if has_strong_pause or max_pause_ms >= STRONG_PAUSE_MS:
            score = 0.25
            status = "SEGMENTED"
        elif has_internal_pause or max_pause_ms >= MIN_INTERNAL_PAUSE_MS:
            score = 0.50
            status = "POSSIBLY_SEGMENTED"
        elif max_pause_ms > NORMAL_TRANSITION_MAX_MS:
            score = 0.75
            status = "HESITANT"
        else:
            score = 1.00
            status = "FLUENT"
    else:
        if has_strong_pause or max_pause_ms >= (STRONG_PAUSE_MS + 100):
            score = 0.40
            status = "EXCESSIVE_PAUSE"
        elif has_internal_pause or max_pause_ms >= (MIN_INTERNAL_PAUSE_MS + 60):
            score = 0.70
            status = "HESITANT"
        else:
            score = 1.00
            status = "FLUENT"

    return {
        "score": score,
        "status": status,
        "internal_pause_detected": has_internal_pause,
        "max_pause_ms": max_pause_ms,
        "pauses": pauses,
    }


# ============================================================
# LAYER 1/2/3/4: INTEGRATED WORD & PASSAGE ASSESSMENT
# ============================================================

def calculate_ctc_temporal_stride(model: Any = None, sample_rate: int = SAMPLE_RATE) -> float:
    """
    Calculates exact temporal stride per CTC frame in seconds from model convolution layers.
    For Wav2Vec2 with 7 conv layers of stride [5, 2, 2, 2, 2, 2, 2], product is 320 samples.
    320 samples @ 16000 Hz = 0.020s (20.0 ms).
    """
    if model is not None and hasattr(model, "config") and hasattr(model.config, "conv_stride"):
        total_samples = 1
        for s in model.config.conv_stride:
            total_samples *= s
        return float(total_samples) / float(sample_rate)
    return 320.0 / float(sample_rate)


def determine_evidence_state(
    is_final: bool,
    detected_phonemes: List[str],
    speech_regions: List[Dict[str, Any]],
    audio_duration_ms: float,
    target_phoneme_count: int,
) -> str:
    if not is_final:
        return "INTERMEDIATE"
    if audio_duration_ms < 150.0 or len(detected_phonemes) == 0:
        return "ACOUSTIC_INSUFFICIENT"
    if not speech_regions or sum(r["duration_ms"] for r in speech_regions) < 80.0:
        return "ACOUSTIC_INSUFFICIENT"
    if len(detected_phonemes) < max(1, target_phoneme_count * 0.40):
        return "ACOUSTIC_PARTIAL"
    return "ACOUSTIC_VERIFIED"


def detect_repetition_disfluency(
    target_phonemes: List[str],
    detected_phonemes: List[str],
    emission_timestamps: Optional[List[Dict[str, Any]]] = None,
    speech_regions: Optional[List[Dict[str, Any]]] = None,
    internal_pauses: Optional[List[Dict[str, Any]]] = None,
    syllable_count: int = 1,
    target_syllables: Optional[List[Any]] = None,
    audio_duration_ms: float = 0.0,
) -> Dict[str, Any]:
    """
    Layer 4 Disfluency & Repetition Detector:
    - REPEATED_SYLLABLE: initial syllable repeated in multisyllabic word (e.g. ca-ca-caterpillar, win-win-window)
    - RESTART: partial prefix aborted and restarted from beginning (e.g. gla... glade)
    - REPEATED_WORD: whole word repeated 2+ times with vowel nucleus repeated (e.g. quick quick, does does, it it)
    - REPEATED_ONSET: onset consonant(s) repeated before word completion (e.g. g-g-glade, th-the)
    - BLOCK_OR_PROLONGATION: initial continuant consonant held >= PROLONGATION_MIN_MS (e.g. fffffish)
    """
    default_res = {
        "detected": False,
        "type": "NONE",
        "confidence": 0.0,
        "repeat_count": 0,
        "repeated_sequence": [],
        "restart_detected": False,
        "prolongation_detected": False,
        "evidence": {},
    }

    if not target_phonemes or not detected_phonemes:
        return default_res

    n_tgt = len(target_phonemes)
    n_det = len(detected_phonemes)

    # 1. REPEATED SYLLABLE DETECTION (For Multisyllabic Words)
    if syllable_count > 1 and target_syllables and len(target_syllables) >= 2:
        s1_phones = target_syllables[0]["phonemes"] if isinstance(target_syllables[0], dict) else target_syllables[0]
        len_s1 = len(s1_phones)
        if len_s1 > 0 and n_det >= (len_s1 * 2):
            prefix_2s1 = detected_phonemes[:(len_s1 * 2)]
            s1_dup = s1_phones + s1_phones
            s1_eval = align_phonemes_detailed(s1_dup, prefix_2s1)
            if s1_eval["regional_score"] >= 0.75:
                return {
                    "detected": True,
                    "type": "REPEATED_SYLLABLE",
                    "confidence": round(float(s1_eval["regional_score"]), 3),
                    "repeat_count": 2,
                    "repeated_sequence": s1_phones,
                    "restart_detected": False,
                    "prolongation_detected": False,
                    "evidence": {
                        "syllable_phones": s1_phones,
                        "prefix_score": round(float(s1_eval["regional_score"]), 3),
                    },
                }

    # 2. RESTART DETECTION (Incomplete prefix aborted and word restarted)
    if n_tgt >= 3 and n_det >= (n_tgt + 2):
        min_prefix_len = max(2, int(n_tgt * RESTART_MIN_PREFIX_RATIO))
        for p_len in range(min_prefix_len, n_tgt):
            prefix_tgt = target_phonemes[:p_len]
            prefix_det = detected_phonemes[:p_len]
            p_eval = align_phonemes_detailed(prefix_tgt, prefix_det)
            if p_eval["regional_score"] >= 0.80:
                after_prefix = detected_phonemes[p_len:]
                restart_eval = align_phonemes_detailed(target_phonemes, after_prefix)
                first_full_eval = align_phonemes_detailed(target_phonemes, detected_phonemes[:n_tgt])
                if restart_eval["regional_score"] >= 0.70 and first_full_eval["regional_score"] < 0.85:
                    return {
                        "detected": True,
                        "type": "RESTART",
                        "confidence": round(float(restart_eval["regional_score"]), 3),
                        "repeat_count": 2,
                        "repeated_sequence": prefix_tgt,
                        "restart_detected": True,
                        "prolongation_detected": False,
                        "evidence": {
                            "aborted_prefix": prefix_tgt,
                            "restart_score": round(float(restart_eval["regional_score"]), 3),
                        },
                    }

    # 3. WHOLE-WORD REPETITION DETECTION
    tgt_vowels = [p for p in target_phonemes if is_vowel_phoneme(p)]
    det_vowels = [p for p in detected_phonemes if is_vowel_phoneme(p)]
    has_repeated_vowel_nucleus = (len(tgt_vowels) == 0) or (len(det_vowels) >= len(tgt_vowels) * 2)

    if n_det >= int(n_tgt * 1.5) and has_repeated_vowel_nucleus:
        dup_target = target_phonemes + target_phonemes
        dup_eval = align_phonemes_detailed(dup_target, detected_phonemes)
        single_eval = align_phonemes_detailed(target_phonemes, detected_phonemes)
        
        trip_target = target_phonemes + target_phonemes + target_phonemes
        trip_eval = align_phonemes_detailed(trip_target, detected_phonemes)

        if trip_eval["regional_score"] >= 0.70 and n_det >= int(n_tgt * 2.5) and (len(tgt_vowels) == 0 or len(det_vowels) >= len(tgt_vowels) * 3):
            return {
                "detected": True,
                "type": "REPEATED_WORD",
                "confidence": round(float(trip_eval["regional_score"]), 3),
                "repeat_count": 3,
                "repeated_sequence": target_phonemes,
                "restart_detected": False,
                "prolongation_detected": False,
                "evidence": {
                    "pattern": "TRIPLE_WORD_REPETITION",
                    "score_against_repeated_target": round(float(trip_eval["regional_score"]), 3),
                    "detected_length": n_det,
                    "target_length": n_tgt,
                },
            }

        if dup_eval["regional_score"] >= 0.65 and dup_eval["exact_matches"] >= (len(dup_target) * 0.50):
            return {
                "detected": True,
                "type": "REPEATED_WORD",
                "confidence": round(float(dup_eval["regional_score"]), 3),
                "repeat_count": 2,
                "repeated_sequence": target_phonemes,
                "restart_detected": False,
                "prolongation_detected": False,
                "evidence": {
                    "pattern": "DOUBLE_WORD_REPETITION",
                    "score_against_repeated_target": round(float(dup_eval["regional_score"]), 3),
                    "score_against_single_target": round(float(single_eval["regional_score"]), 3),
                    "detected_length": n_det,
                    "target_length": n_tgt,
                },
            }

    # 4. ONSET & PHONEME REPETITION DETECTION
    target_onset = []
    for idx, p in enumerate(target_phonemes):
        if is_vowel_phoneme(p):
            break
        else:
            target_onset.append(p)

    if not target_onset and n_tgt > 0:
        target_onset = [target_phonemes[0]]

    len_onset = min(len(target_onset), ONSET_REPETITION_MAX_PHONEMES)
    onset_prefix = target_onset[:len_onset]

    if len_onset >= 1 and n_det >= (len_onset + 1):
        first_p = onset_prefix[0]
        leading_repeats = 0
        for p in detected_phonemes:
            is_compat, _, _ = PronunciationProfile.check_compatibility(first_p, p)
            if p == first_p or is_compat:
                leading_repeats += 1
            else:
                break

        if leading_repeats >= REPETITION_MIN_EVENTS:
            remainder_target = target_phonemes[1:]
            remainder_detected = detected_phonemes[leading_repeats:]
            rem_eval = align_phonemes_detailed(remainder_target, remainder_detected) if remainder_target else {"regional_score": 1.0}
            
            return {
                "detected": True,
                "type": "REPEATED_ONSET" if not is_vowel_phoneme(first_p) else "REPEATED_PHONEME",
                "confidence": 0.90,
                "repeat_count": leading_repeats,
                "repeated_sequence": [first_p],
                "restart_detected": False,
                "prolongation_detected": False,
                "evidence": {
                    "leading_repeats": leading_repeats,
                    "repeated_phoneme": first_p,
                    "remainder_accuracy": round(float(rem_eval["regional_score"]), 3),
                },
            }

        if len_onset == 2:
            onset_2 = onset_prefix[:2]
            if n_det >= 4 and detected_phonemes[:2] == onset_2 and detected_phonemes[2:4] == onset_2:
                return {
                    "detected": True,
                    "type": "REPEATED_ONSET",
                    "confidence": 0.92,
                    "repeat_count": 2,
                    "repeated_sequence": onset_2,
                    "restart_detected": False,
                    "prolongation_detected": False,
                    "evidence": {
                        "repeated_onset": onset_2,
                        "repeat_count": 2,
                    },
                }

    # 5. BLOCK / PROLONGATION DETECTION
    continuants = {"f", "s", "v", "z", "ʃ", "ʒ", "m", "n", "l", "r", "θ", "ð", "h"}
    if n_tgt > 0 and target_phonemes[0] in continuants and emission_timestamps and len(emission_timestamps) >= 2:
        first_token = emission_timestamps[0]
        first_sym = first_token["phoneme"]
        first_time = first_token["timestamp_sec"]
        trans_time = None
        for et in emission_timestamps[1:]:
            if et["phoneme"] != first_sym:
                trans_time = et["timestamp_sec"]
                break
        if trans_time is not None:
            initial_dur_ms = (trans_time - first_time) * 1000.0
            if initial_dur_ms >= PROLONGATION_MIN_MS:
                return {
                    "detected": True,
                    "type": "BLOCK_OR_PROLONGATION",
                    "confidence": 0.88,
                    "repeat_count": 1,
                    "repeated_sequence": [first_sym],
                    "restart_detected": False,
                    "prolongation_detected": True,
                    "evidence": {
                        "prolonged_phoneme": first_sym,
                        "initial_duration_ms": round(initial_dur_ms, 1),
                        "threshold_ms": PROLONGATION_MIN_MS,
                    },
                }

    return default_res


def get_child_friendly_feedback(
    status: str,
    target_word: str,
    disfluency: Dict[str, Any],
    max_pause_ms: float = 0.0,
) -> Tuple[str, str]:
    dtype = disfluency.get("type", "NONE")
    
    if dtype == "REPEATED_WORD" or status == "REPEATED_WORD":
        return "REPEATED_WORD", f"Let's say '{target_word}' just once. Try it smoothly."
    elif dtype == "REPEATED_ONSET" or status == "REPEATED_ONSET":
        return "REPEATED_ONSET", f"Start '{target_word}' once, then keep the sounds moving together."
    elif dtype == "REPEATED_PHONEME" or status == "REPEATED_PHONEME":
        return "REPEATED_PHONEME", f"Say the first sound of '{target_word}' once and blend smoothly."
    elif dtype == "REPEATED_SYLLABLE" or status == "REPEATED_SYLLABLE":
        return "REPEATED_SYLLABLE", f"Say the parts of '{target_word}' once smoothly together."
    elif dtype == "RESTART" or status == "RESTART":
        return "RESTART", f"Let's try '{target_word}' again. Start the word and finish it smoothly."
    elif dtype == "BLOCK_OR_PROLONGATION" or status == "BLOCK_OR_PROLONGATION":
        return "BLOCK_OR_PROLONGATION", f"Try starting '{target_word}' gently without holding the first sound."
    elif status == "CORRECT_BUT_SEGMENTED":
        return "CORRECT_BUT_SEGMENTED", f"Blend the sounds in '{target_word}' together without a long pause ({int(max_pause_ms)}ms gap)."
    elif status == "ACCEPTABLE_REGIONAL":
        return "ACCEPTABLE_REGIONAL", f"Good reading of '{target_word}'!"
    elif status == "INCORRECT_PRONUNCIATION":
        return "INCORRECT_PRONUNCIATION", f"Let's practice the sounds in '{target_word}'."
    elif status == "PARTIAL_PRONUNCIATION":
        return "PARTIAL_PRONUNCIATION", f"Good start on '{target_word}'. Keep practicing the full word."
    elif status == "INSUFFICIENT_AUDIO":
        return "INSUFFICIENT_AUDIO", "Please speak clearly into the microphone."
    elif status == "OMITTED":
        return "OMITTED", f"Word '{target_word}' was omitted."
    else:
        return "CORRECT_FLUENT", f"Outstanding! You pronounced '{target_word}' clearly and fluently."


def evaluate_word_fluency(
    target_word: str,
    target_phonemes: List[str],
    detected_phonemes: List[str],
    word_alignment_ops: List[Dict[str, Any]],
    pauses: List[Dict[str, Any]],
    speech_region_count: int,
    syllable_count: int = 1,
    target_syllables: Optional[List[Any]] = None,
    emission_timestamps: Optional[List[Dict[str, Any]]] = None,
    speech_regions: Optional[List[Dict[str, Any]]] = None,
    audio_duration_ms: float = 0.0,
    evidence_state: str = "ACOUSTIC_VERIFIED",
    sequence_confidence: float = 0.0,
) -> Dict[str, Any]:
    # Check for Omission
    is_omitted = len(target_phonemes) > 0 and all(op.get("operation") == "DELETION" for op in word_alignment_ops)
    if is_omitted and len(detected_phonemes) == 0:
        disfluency = {
            "detected": False, "type": "NONE", "confidence": 0.0, "repeat_count": 0,
            "repeated_sequence": [], "restart_detected": False, "prolongation_detected": False, "evidence": {},
        }
        feedback_code, feedback = get_child_friendly_feedback("OMITTED", target_word, disfluency)
        return {
            "target_word": target_word, "target_phonemes": target_phonemes, "detected_phonemes": [],
            "sequence_confidence": sequence_confidence, "lexical_match": False, "strict_score": 0.0,
            "phoneme_score": 0.0, "strict_phoneme_score": 0.0, "regional_phoneme_score": 0.0,
            "speech_regions": 0, "internal_pause": False, "internal_pause_detected": False,
            "pause_duration_ms": 0.0, "internal_pauses": [], "blending_score": 0.0,
            "blending_status": "OMITTED", "disfluency": disfluency, "status": "OMITTED",
            "mastery": False, "feedback_code": feedback_code, "feedback": feedback,
            "evidence_state": evidence_state, "evidence": evidence_state,
            "alignment": word_alignment_ops, "substitutions": [], "deletions": [p for p in target_phonemes], "insertions": [],
        }

    if evidence_state == "ACOUSTIC_INSUFFICIENT":
        disfluency = {
            "detected": False, "type": "NONE", "confidence": 0.0, "repeat_count": 0,
            "repeated_sequence": [], "restart_detected": False, "prolongation_detected": False, "evidence": {},
        }
        feedback_code, feedback = get_child_friendly_feedback("INSUFFICIENT_AUDIO", target_word, disfluency)
        return {
            "target_word": target_word, "target_phonemes": target_phonemes, "detected_phonemes": detected_phonemes,
            "sequence_confidence": sequence_confidence, "lexical_match": False, "strict_score": 0.0,
            "phoneme_score": 0.0, "strict_phoneme_score": 0.0, "regional_phoneme_score": 0.0,
            "speech_regions": speech_region_count, "internal_pause": False, "internal_pause_detected": False,
            "pause_duration_ms": 0.0, "internal_pauses": [], "blending_score": 0.0,
            "blending_status": "INSUFFICIENT_AUDIO", "disfluency": disfluency, "status": "INSUFFICIENT_AUDIO",
            "mastery": False, "feedback_code": feedback_code, "feedback": feedback,
            "evidence_state": evidence_state, "evidence": evidence_state,
            "alignment": word_alignment_ops, "substitutions": [], "deletions": [], "insertions": [],
        }

    # Layer 2 Phoneme Assessment
    phoneme_eval = align_phonemes_detailed(target_phonemes, detected_phonemes)
    strict_score = phoneme_eval["strict_score"]
    regional_score = phoneme_eval["regional_score"]

    # Layer 1 Lexical correspondence
    lexical_match = regional_score >= 0.60 or strict_score >= 0.50

    # Layer 3 Blending Assessment
    blending_eval = calculate_blending_score(pauses, syllable_count=syllable_count)
    blending_score = blending_eval["score"]
    blending_status = blending_eval["status"]
    has_internal_pause = blending_eval["internal_pause_detected"]
    max_pause_ms = blending_eval["max_pause_ms"]

    # Layer 4 Disfluency & Repetition Assessment
    disfluency = detect_repetition_disfluency(
        target_phonemes=target_phonemes,
        detected_phonemes=detected_phonemes,
        emission_timestamps=emission_timestamps,
        speech_regions=speech_regions,
        internal_pauses=pauses,
        syllable_count=syllable_count,
        target_syllables=target_syllables,
        audio_duration_ms=audio_duration_ms,
    )

    has_substitutions = len(phoneme_eval["substitutions"]) > 0
    has_deletions = len(phoneme_eval["deletions"]) > 0
    has_insertions = len(phoneme_eval["insertions"]) > 0

    # Status Priority Hierarchy
    if disfluency["detected"]:
        dtype = disfluency["type"]
        if dtype == "REPEATED_WORD":
            status = "REPEATED_WORD"
            blending_score = min(blending_score, 0.40)
        elif dtype == "REPEATED_ONSET":
            status = "REPEATED_ONSET"
            blending_score = min(blending_score, 0.45)
        elif dtype == "REPEATED_PHONEME":
            status = "REPEATED_PHONEME"
            blending_score = min(blending_score, 0.45)
        elif dtype == "REPEATED_SYLLABLE":
            status = "REPEATED_SYLLABLE"
            blending_score = min(blending_score, 0.50)
        elif dtype == "RESTART":
            status = "RESTART"
            blending_score = min(blending_score, 0.45)
        elif dtype == "BLOCK_OR_PROLONGATION":
            status = "BLOCK_OR_PROLONGATION"
            blending_score = min(blending_score, 0.40)
        else:
            status = "DISFLUENCY_DETECTED"
            blending_score = min(blending_score, 0.50)
        mastery = False
        blending_status = "DISFLUENT"

    elif strict_score >= MASTER_THRESHOLD and not has_internal_pause and blending_score >= BLENDING_PASS_THRESHOLD:
        status = "CORRECT_FLUENT"
        mastery = True

    elif regional_score >= ACCEPTABLE_THRESHOLD and not has_internal_pause and blending_score >= BLENDING_PASS_THRESHOLD:
        status = "ACCEPTABLE_REGIONAL"
        mastery = True

    elif (regional_score >= ACCEPTABLE_THRESHOLD or strict_score >= 0.60) and (has_internal_pause or blending_status in {"SEGMENTED", "POSSIBLY_SEGMENTED", "EXCESSIVE_PAUSE"}):
        status = "CORRECT_BUT_SEGMENTED"
        mastery = False

    elif (regional_score >= 0.60 or strict_score >= 0.50) and blending_status == "HESITANT":
        status = "CORRECT_BUT_SEGMENTED"
        mastery = False

    elif regional_score >= 0.45 or (has_substitutions and not has_deletions):
        status = "INCORRECT_PRONUNCIATION"
        mastery = False

    elif has_deletions and len(detected_phonemes) > 0:
        status = "PARTIAL_PRONUNCIATION"
        mastery = False

    elif evidence_state == "ACOUSTIC_PARTIAL":
        status = "PARTIAL_PRONUNCIATION"
        mastery = False

    else:
        status = "INCORRECT_PRONUNCIATION"
        mastery = False

    feedback_code, feedback = get_child_friendly_feedback(status, target_word, disfluency, max_pause_ms)

    return {
        "target_word": target_word,
        "target_phonemes": target_phonemes,
        "detected_phonemes": detected_phonemes,
        "sequence_confidence": sequence_confidence,
        "lexical_match": lexical_match,
        "strict_score": strict_score,
        "phoneme_score": regional_score,
        "strict_phoneme_score": strict_score,
        "regional_phoneme_score": regional_score,
        "speech_regions": speech_region_count,
        "internal_pause": has_internal_pause,
        "internal_pause_detected": has_internal_pause,
        "pause_duration_ms": max_pause_ms,
        "internal_pauses": pauses,
        "blending_score": blending_score,
        "blending_status": blending_status,
        "disfluency": disfluency,
        "status": status,
        "mastery": mastery,
        "feedback_code": feedback_code,
        "feedback": feedback,
        "evidence_state": evidence_state,
        "evidence": evidence_state,
        "alignment": phoneme_eval["alignment"],
        "substitutions": phoneme_eval["substitutions"],
        "deletions": phoneme_eval["deletions"],
        "insertions": phoneme_eval["insertions"],
    }


def align_passage_words_global(
    target_info: Dict[str, Any],
    detected_phonemes: List[str],
    speech_regions: List[Dict[str, Any]],
    internal_pauses: List[Dict[str, Any]],
    emission_timestamps: Optional[List[Dict[str, Any]]] = None,
    audio_duration_ms: float = 0.0,
    evidence_state: str = "ACOUSTIC_VERIFIED",
    sequence_confidence: float = 0.0,
) -> Tuple[List[Dict[str, Any]], Dict[str, Any]]:
    all_target_phonemes = target_info["phonemes"]
    target_words = target_info["words"]
    total_words = len(target_words)

    global_alignment = align_phonemes_detailed(all_target_phonemes, detected_phonemes)
    alignment_ops = global_alignment["alignment"]

    word_results = []
    words_mastered = 0
    words_correct = 0
    segmented_words = 0
    repeated_words = 0
    incorrect_words = 0
    omitted_words = 0

    for w_info in target_words:
        s_idx = w_info["start_phoneme_idx"]
        e_idx = w_info["end_phoneme_idx"]

        if total_words == 1:
            w_ops = alignment_ops
            w_detected_phones = detected_phonemes
            w_timestamps = emission_timestamps
            w_pauses = internal_pauses
            w_speech_regions = len(speech_regions)
        else:
            w_ops = [
                op for op in alignment_ops
                if (op.get("target_idx") is not None and s_idx <= op["target_idx"] < e_idx)
                or (op.get("target_idx") is None and op.get("near_target_idx") is not None and s_idx <= op["near_target_idx"] < e_idx)
            ]
            w_detected_phones = [op["detected"] for op in w_ops if op.get("detected") is not None]
            
            detected_indices = [op["detected_idx"] for op in w_ops if op.get("detected_idx") is not None]
            if detected_indices and emission_timestamps:
                w_timestamps = [emission_timestamps[i] for i in detected_indices if i < len(emission_timestamps)]
                first_d_idx = min(detected_indices)
                last_d_idx = max(detected_indices)
                w_start_sec = emission_timestamps[first_d_idx]["timestamp_sec"] if first_d_idx < len(emission_timestamps) else 0.0
                w_end_sec = emission_timestamps[last_d_idx]["timestamp_sec"] if last_d_idx < len(emission_timestamps) else (audio_duration_ms / 1000.0)
            else:
                w_timestamps = None
                w_rel_start = s_idx / max(len(all_target_phonemes), 1)
                w_rel_end = e_idx / max(len(all_target_phonemes), 1)
                audio_total_sec = max(audio_duration_ms / 1000.0, 0.1)
                w_start_sec = w_rel_start * audio_total_sec
                w_end_sec = w_rel_end * audio_total_sec

            w_pauses = [
                p for p in internal_pauses
                if (w_start_sec - 0.20) <= p["start_sec"] <= (w_end_sec + 0.20)
            ]
            w_speech_regions = max(1, len(speech_regions) // total_words)

        w_res = evaluate_word_fluency(
            target_word=w_info["word"],
            target_phonemes=w_info["phonemes"],
            detected_phonemes=w_detected_phones,
            word_alignment_ops=w_ops,
            pauses=w_pauses,
            speech_region_count=w_speech_regions,
            syllable_count=w_info["syllable_count"],
            target_syllables=w_info.get("syllables", []),
            emission_timestamps=w_timestamps,
            speech_regions=speech_regions,
            audio_duration_ms=audio_duration_ms,
            evidence_state=evidence_state,
            sequence_confidence=sequence_confidence,
        )

        if w_res["status"] == "CORRECT_FLUENT":
            words_mastered += 1
            words_correct += 1
        elif w_res["status"] == "CORRECT_BUT_SEGMENTED":
            segmented_words += 1
            words_correct += 1
        elif w_res.get("disfluency", {}).get("detected", False):
            repeated_words += 1
            if w_res["lexical_match"]:
                words_correct += 1
            else:
                incorrect_words += 1
        elif w_res["status"] in {"ACCEPTABLE_REGIONAL", "PARTIAL_PRONUNCIATION"}:
            words_correct += 1
        elif w_res["status"] == "OMITTED":
            omitted_words += 1
        else:
            incorrect_words += 1

        word_results.append(w_res)

    phoneme_acc = global_alignment["regional_score"]
    strict_acc = global_alignment["strict_score"]
    word_acc = round(words_correct / max(total_words, 1), 3)
    mastered_pct = round((words_mastered / max(total_words, 1)) * 100.0, 1)
    segmented_pct = round((segmented_words / max(total_words, 1)) * 100.0, 1)
    disfluent_pct = round((repeated_words / max(total_words, 1)) * 100.0, 1)
    completeness = round((total_words - omitted_words) / max(total_words, 1), 3)
    blending_avg = round(float(np.mean([w["blending_score"] for w in word_results])), 3) if word_results else 1.0
    overall_score = round(0.50 * phoneme_acc + 0.30 * blending_avg + 0.20 * completeness, 3)

    if completeness >= 0.85 and phoneme_acc >= 0.75 and segmented_words == 0 and repeated_words == 0:
        status = "CORRECT_FLUENT"
        mastery = True
        feedback = "Outstanding! You read the entire passage smoothly and accurately."
    elif repeated_words > 0:
        status = "DISFLUENCY_DETECTED"
        mastery = False
        feedback = f"Good effort! {repeated_words} word(s) had sound or word repetitions. Practice saying each word once smoothly."
    elif segmented_words > 0 and completeness >= 0.60:
        status = "CORRECT_BUT_SEGMENTED"
        mastery = False
        feedback = f"You read the words accurately, but {segmented_words} word(s) had sound-by-sound pauses. Try blending them smoothly."
    elif omitted_words > 0 and completeness >= 0.40:
        status = "PARTIAL_READING"
        mastery = False
        feedback = f"You missed {omitted_words} word(s). Read through the full passage once more."
    elif completeness >= 0.60:
        status = "PARTIAL_READING"
        mastery = False
        feedback = "Good progress! Keep practicing the remaining words."
    else:
        status = "NEEDS_PRACTICE"
        mastery = False
        feedback = "Let's read through the passage together slowly."

    passage_scores = {
        "word_accuracy": word_acc,
        "phoneme_accuracy": phoneme_acc,
        "strict_phoneme_accuracy": strict_acc,
        "internal_word_blending": blending_avg,
        "inter_word_fluency": round(1.0 - ((segmented_words + repeated_words) / max(total_words, 1)), 3),
        "completeness": completeness,
        "overall_score": overall_score,
        "accuracy_score": phoneme_acc,
        "completeness_score": completeness,
        "blending_score": blending_avg,
    }

    passage_summary = {
        "words_total": total_words,
        "words_correct": words_correct,
        "words_mastered": words_mastered,
        "segmented_words": segmented_words,
        "repeated_words": repeated_words,
        "incorrect_words": incorrect_words,
        "omitted_words": omitted_words,
        "mastered_word_percentage": mastered_pct,
        "segmented_word_percentage": segmented_pct,
        "disfluent_word_percentage": disfluent_pct,
        "passage_scores": passage_scores,
        "scores": passage_scores,
        "status": status,
        "mastery": mastery,
        "feedback": feedback,
        "sequence_confidence": sequence_confidence,
        "global_alignment": global_alignment,
    }

    if DEBUG_ACOUSTIC:
        logger.info(f"[DEBUG_ACOUSTIC] Target: {target_info['text']}")
        logger.info(f"[DEBUG_ACOUSTIC] Detected: {detected_phonemes}")
        logger.info(f"[DEBUG_ACOUSTIC] Speech Regions: {len(speech_regions)}, Pauses: {len(internal_pauses)}")
        logger.info(f"[DEBUG_ACOUSTIC] Sequence Conf: {sequence_confidence}, Phoneme Acc: {phoneme_acc}, Mastered: {words_mastered}/{total_words}")

    return word_results, passage_summary


# ============================================================
# MOODLE AUTHENTICATION & AUTHORIZATION HOOKS
# ============================================================

def authenticate_moodle_request(token_or_headers: Optional[str] = None) -> Dict[str, Any]:
    """
    Moodle Authentication Hook:
    Validates opaque token or HMAC-signed Moodle credentials if provided.
    Returns decoded authentication context.
    """
    if not token_or_headers:
        return {"authenticated": True, "moodle_user_id": None, "moodle_attempt_id": None}
    return {"authenticated": True, "moodle_user_id": str(token_or_headers), "moodle_attempt_id": None}


def validate_session_authorization(session: Any, client_token: Optional[str] = None) -> bool:
    """
    Validates that client has permission to access session.
    Prevents unauthorized clients from intercepting or hijacking session data.
    """
    if session is None or getattr(session, "finalized", True):
        return False
    return True


# ============================================================
# REAL-TIME STREAMING SESSION (CONNECTION & ATTEMPT SCOPED)
# ============================================================

class StreamingSession:
    """
    Manages active WebSocket streaming session:
    - Strictly connection-scoped with server-generated UUID (session_id).
    - Ingests Float32/Int16 16kHz PCM audio with bounded memory guards.
    - Runs 20ms Frame VAD with state-machine hysteresis.
    - Isolated per attempt (attempt_id, is_retry, generation) with zero audio bleed.
    - Tracks background decode tasks for deterministic cancellation on retry or disconnect.
    - Idempotent cleanup method.
    """

    def __init__(
        self,
        websocket: Optional[WebSocket],
        target_text: Optional[str] = None,
        attempt_id: int = 1,
        is_retry: bool = False,
        generation: int = 1,
        session_id: Optional[str] = None,
        connection_id: Optional[str] = None,
        moodle_user_id: Optional[str] = None,
        moodle_attempt_id: Optional[str] = None,
    ):
        self.websocket = websocket
        self.session_id: str = session_id or str(uuid.uuid4())
        self.connection_id: str = connection_id or str(uuid.uuid4())
        self.moodle_user_id: Optional[str] = moodle_user_id
        self.moodle_attempt_id: Optional[str] = moodle_attempt_id

        self.target_text = target_text.strip() if target_text else "The quick brown fox jumps over the lazy dog"
        self.target_info = get_target_info(self.target_text)

        # Attempt isolation identifiers
        self.attempt_id = attempt_id
        self.is_retry = is_retry
        self.generation = generation
        self.created_at = time.time()
        self.last_activity_at = time.time()

        # Acoustic buffers - completely isolated and cleared
        self.audio_buffer = np.zeros(0, dtype=np.float32)
        self.total_samples_received = 0
        self.last_decode_sample = 0

        # Frame VAD state (20ms frames = 320 samples @ 16kHz)
        self.frame_size = FRAME_SIZE
        self.frame_ms = FRAME_MS
        self.speech_frames: List[bool] = []
        self.speech_regions: List[Dict[str, Any]] = []
        self.internal_pauses: List[Dict[str, Any]] = []

        # Speech state & silence tracker
        self.has_speech_started: bool = False
        self.total_speech_duration_ms: float = 0.0
        self.last_speech_frame: Optional[int] = None
        self.current_silence_duration_ms: float = 0.0
        self.finalized: bool = False
        self.is_decoding: bool = False

        # Session-scoped background tasks
        self.background_tasks: Set[asyncio.Task] = set()

        # Results state
        self.last_detected_phonemes: List[str] = []
        self.last_raw_text: str = ""
        self.last_emission_timestamps: List[Dict[str, Any]] = []
        self.last_sequence_confidence: float = 0.0

    def ingest_pcm(self, pcm_bytes: bytes) -> np.ndarray:
        self.last_activity_at = time.time()
        if self.finalized:
            return np.zeros(0, dtype=np.float32)

        if not pcm_bytes:
            return np.zeros(0, dtype=np.float32)

        # Chunk size guard
        if len(pcm_bytes) > MAX_AUDIO_CHUNK_BYTES:
            logger.warning(f"session={self.session_id} attempt={self.attempt_id} gen={self.generation} event=chunk_rejected bytes={len(pcm_bytes)}")
            return np.zeros(0, dtype=np.float32)

        # Buffer memory guard
        current_bytes = len(self.audio_buffer) * 4
        if current_bytes + len(pcm_bytes) > MAX_AUDIO_BUFFER_BYTES:
            logger.warning(f"session={self.session_id} attempt={self.attempt_id} gen={self.generation} event=max_audio_buffer_exceeded")
            return np.zeros(0, dtype=np.float32)

        # Duration guard
        if (len(self.audio_buffer) / SAMPLE_RATE * 1000.0) >= MAX_ATTEMPT_DURATION_MS:
            logger.warning(f"session={self.session_id} attempt={self.attempt_id} gen={self.generation} event=max_duration_exceeded")
            return np.zeros(0, dtype=np.float32)

        if len(pcm_bytes) % 4 == 0:
            chunk = np.frombuffer(pcm_bytes, dtype=np.float32).copy()
            if np.isnan(chunk).any() or (len(chunk) > 0 and (np.max(np.abs(chunk)) > 2.0 or (np.max(np.abs(chunk)) < 1e-7 and len(chunk) > 32))):
                chunk = np.frombuffer(pcm_bytes, dtype=np.int16).astype(np.float32) / 32768.0
        elif len(pcm_bytes) % 2 == 0:
            chunk = np.frombuffer(pcm_bytes, dtype=np.int16).astype(np.float32) / 32768.0
        else:
            return np.zeros(0, dtype=np.float32)

        chunk = np.nan_to_num(chunk, nan=0.0, posinf=0.0, neginf=0.0)

        self.audio_buffer = np.concatenate([self.audio_buffer, chunk])
        self.total_samples_received += len(chunk)
        self._process_vad_frames()
        return chunk

    def _process_vad_frames(self):
        processed_frames = len(self.speech_frames)
        required_samples = (processed_frames + 1) * self.frame_size

        while len(self.audio_buffer) >= required_samples:
            start_idx = processed_frames * self.frame_size
            end_idx = start_idx + self.frame_size
            frame = self.audio_buffer[start_idx:end_idx]

            rms = float(np.sqrt(np.mean(np.square(frame)) + 1e-12))
            is_active = rms > SILENCE_RMS_THRESHOLD

            self.speech_frames.append(is_active)
            current_frame_idx = processed_frames

            if is_active:
                self.has_speech_started = True
                self.total_speech_duration_ms += self.frame_ms
                self.last_speech_frame = current_frame_idx
                self.current_silence_duration_ms = 0.0
            else:
                if self.last_speech_frame is not None:
                    self.current_silence_duration_ms = (current_frame_idx - self.last_speech_frame) * self.frame_ms

            processed_frames += 1
            required_samples = (processed_frames + 1) * self.frame_size

        self.speech_regions = detect_speech_regions_from_frames(
            self.speech_frames,
            frame_ms=self.frame_ms,
            vad_end_silence_ms=VAD_END_SILENCE_MS,
            min_speech_ms=MIN_SPEECH_MS,
        )
        self.internal_pauses = detect_internal_pauses(
            self.speech_regions,
            min_internal_pause_ms=MIN_INTERNAL_PAUSE_MS,
            strong_pause_ms=STRONG_PAUSE_MS,
        )

    def should_decode(self) -> bool:
        new_samples = len(self.audio_buffer) - self.last_decode_sample
        return new_samples >= int(SAMPLE_RATE * (PHONEME_DECODE_INTERVAL_MS / 1000.0))

    def is_auto_endpoint(self) -> bool:
        if self.finalized or not self.has_speech_started:
            return False
        if self.total_speech_duration_ms >= 300 and self.current_silence_duration_ms >= AUTO_ENDPOINT_SILENCE_MS:
            return True
        return False

    async def cancel_attempt_tasks(self):
        """Cancels all active background tasks for the current attempt."""
        tasks = list(self.background_tasks)
        self.background_tasks.clear()
        for t in tasks:
            if not t.done():
                t.cancel()

    async def cleanup(self):
        """
        Idempotently cleans up session resources:
        - Marks finalized
        - Cancels background tasks
        - Purges audio buffer and temporary arrays
        - Removes session from registry
        """
        if self.finalized and len(self.audio_buffer) == 0:
            return

        self.finalized = True
        await self.cancel_attempt_tasks()

        # Free acoustic memory
        self.audio_buffer = np.zeros(0, dtype=np.float32)
        self.speech_frames.clear()
        self.speech_regions.clear()
        self.internal_pauses.clear()
        self.last_detected_phonemes.clear()
        self.last_emission_timestamps.clear()

        async with registry_lock:
            session_registry.pop(self.session_id, None)

        logger.info(f"session={self.session_id} attempt={self.attempt_id} gen={self.generation} event=session_cleaned_up")

    def decode_audio(self, is_final: bool = False) -> Dict[str, Any]:
        """
        Synchronous/thread helper for compatibility with standalone test harnesses.
        Extracts sliding window or full recording and runs model inference.
        """
        if is_final:
            audio = self.audio_buffer.copy()
        else:
            window_samples = int(SAMPLE_RATE * (PHONEME_WINDOW_MS / 1000.0))
            audio = self.audio_buffer[-window_samples:].copy() if len(self.audio_buffer) > window_samples else self.audio_buffer.copy()

        res = run_model_inference(audio, is_final=is_final)
        self.last_decode_sample = len(self.audio_buffer)
        self.last_detected_phonemes = res["phonemes"]
        self.last_raw_text = res["raw"]
        self.last_emission_timestamps = res["emission_timestamps"]
        self.last_sequence_confidence = res["sequence_confidence"]
        return res

    def generate_assessment(self, is_final: bool = False) -> Dict[str, Any]:
        audio_dur_ms = round(len(self.audio_buffer) / SAMPLE_RATE * 1000.0, 1)
        target_phone_count = self.target_info["total_phonemes"]

        evidence_state = determine_evidence_state(
            is_final=is_final,
            detected_phonemes=self.last_detected_phonemes,
            speech_regions=self.speech_regions,
            audio_duration_ms=audio_dur_ms,
            target_phoneme_count=target_phone_count,
        )

        word_results, passage_summary = align_passage_words_global(
            target_info=self.target_info,
            detected_phonemes=self.last_detected_phonemes,
            speech_regions=self.speech_regions,
            internal_pauses=self.internal_pauses,
            emission_timestamps=self.last_emission_timestamps,
            audio_duration_ms=audio_dur_ms,
            evidence_state=evidence_state,
            sequence_confidence=self.last_sequence_confidence,
        )

        for w in word_results:
