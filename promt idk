    margin: 14px 0;
}

.ra-streaming-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    padding: 5px 14px;
    border-radius: 9999px;
}

.ra-vad-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #cbd5e1;
    display: inline-block;
}

.ra-vad-dot-active {
    background: #22c55e;
    box-shadow: 0 0 10px rgba(34, 197, 94, 0.75);
    animation: vadPulse 1.5s infinite;
}

.ra-vad-dot-muted {
    background: #f59e0b;
    box-shadow: 0 0 8px rgba(245, 158, 11, 0.6);
    animation: none;
}

@keyframes vadPulse {
    0% { transform: scale(0.95); opacity: 0.85; }
    50% { transform: scale(1.25); opacity: 1; }
    100% { transform: scale(0.95); opacity: 0.85; }
}

/* Teacher Access Bar */
.ra-teacher-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 12px 18px;
    margin-bottom: 20px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.04);
}

.ra-teacher-title {
