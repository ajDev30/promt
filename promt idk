    align-items: center;
    gap: 8px;
    font-weight: 700;
    color: #1e293b;
    font-size: 1rem;
}

.ra-teacher-btn {
    background: #0284c7;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    display: inline-flex;
