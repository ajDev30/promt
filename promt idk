}

/* Finish Line & Completed Words Container */
.ra-finish-line-container {
    margin-top: 20px;
    padding: 16px;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
}

.ra-finish-line-label {
    font-size: 0.95rem;
    font-weight: 700;
    color: #475569;
    margin-bottom: 12px;
}

.ra-finish-chips-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
}

/* Finish Chips */
.ra-finish-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    user-select: none;
}

.ra-finish-chip:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
}

.ra-finish-chip-good {
    background: #dcfce7;
    color: #15803d;
    border: 1px solid #86efac;
}

.ra-finish-chip-miscue {
    background: #ffe4e6;
    color: #be123c;
    border: 1px solid #fca5a5;
}

/* Phoneme Tooltip (Hidden by default, shown on hover) */
.ra-phoneme-tooltip {
    visibility: hidden;
    opacity: 0;
    width: 230px;
    background-color: #1e293b;
    color: #f8fafc;
    text-align: left;
    border-radius: 8px;
    padding: 10px 14px;
    position: absolute;
    z-index: 9999;
    bottom: 125%;
    left: 50%;
    transform: translateX(-50%);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.25);
    transition: opacity 0.2s ease, visibility 0.2s ease;
    pointer-events: none;
    font-size: 0.82rem;
    line-height: 1.4;
    font-weight: normal;
}

.ra-phoneme-tooltip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    margin-left: -6px;
    border-width: 6px;
    border-style: solid;
    border-color: #1e293b transparent transparent transparent;
}

.ra-finish-chip:hover .ra-phoneme-tooltip {
    visibility: visible;
    opacity: 1;
}

.ra-tooltip-header {
